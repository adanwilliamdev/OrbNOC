PORT=3001
JWT_SECRET=troque_por_um_segredo_forte_e_unico
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_SSL=false
FRONTEND_URL=http://localhost:3000
# Origens extras liberadas no CORS, separadas por vírgula (opcional)
EXTRA_CORS_ORIGINS=
# Regex opcional para liberar vários domínios (ex.: previews da Vercel):
# CORS_ORIGIN_REGEX=^https://(meu-app|meu-app-[a-z0-9-]+-meuusuario)\.vercel\.app$
MONITOR_INTERVAL_MS=10000

# Produção (ex.: Render): defina ENVIRONMENT=production e uma senha de admin.
# Sem ADMIN_PASSWORD em produção, nenhum usuário admin é criado.
# ENVIRONMENT=production
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@seudominio.com
# ADMIN_PASSWORD=
