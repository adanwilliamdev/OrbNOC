# ATENÇÃO: se for buildar via Docker (docker-compose.yml), essa variável
# precisa ser passada como build arg (veja docker-compose.yml -> frontend ->
# build.args), não só aqui — o Next.js embute NEXT_PUBLIC_* no JS durante o
# `npm run build`, que já roda dentro da imagem antes do container existir.
NEXT_PUBLIC_API_URL=http://localhost:3001
