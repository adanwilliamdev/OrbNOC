# Só para `next dev` sem Caddy. Em produção não há variável de ambiente do frontend.
# Encaminha /api para o backend (http://localhost:8000).
BACKEND_URL=http://localhost:8000
# O rewrite do Next não faz proxy de WebSocket; em dev, aponte direto para o backend.
# Adicione http://localhost:3000 em EXTRA_ORIGINS no backend.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
