# Copie para .env (desenvolvimento local). Em Docker, use o .env da raiz do projeto.
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbnoc
REDIS_URL=redis://localhost:6379/0

# Obrigatório em produção (mín. 32 caracteres). Gere com: openssl rand -hex 32
JWT_SECRET=
# Opcional: chave Fernet própria para os tokens do Telegram. Sem ela, é derivada do JWT_SECRET.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Origem pública (a do Caddy). Requisições que alteram estado só aceitam este Origin.
PUBLIC_URL=http://localhost:8080
# Outras origens permitidas, separadas por vírgula (ex.: next dev em http://localhost:3000)
EXTRA_ORIGINS=

# Primeiro admin (não existe mais login demo). Sem ADMIN_PASSWORD, nenhum admin é criado.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
REGISTRATION_ENABLED=false

# Redes privadas (10.x, 192.168.x...) liberadas: monitorar a LAN é o objetivo.
# Loopback, link-local e metadata de nuvem ficam sempre bloqueados.
ALLOW_PRIVATE_NETWORKS=true

WORKER_TICK_SECONDS=2
MONITOR_CONCURRENCY=20
PROBE_TIMEOUT_SECONDS=2
METRICS_RETENTION_DAYS=14
ENABLE_DOCS=false
