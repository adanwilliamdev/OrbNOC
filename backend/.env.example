# ============================================================
# OrbNOC backend — copie para .env e ajuste. NUNCA versione o .env.
# ============================================================
ENVIRONMENT=development            # development | production | test

# --- Banco e Redis ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbnoc
DATABASE_SSL=false                 # true para bancos gerenciados que exigem TLS
REDIS_URL=redis://localhost:6379/0

# --- Segurança ---
# Produção: OBRIGATÓRIO, mín. 32 caracteres. Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Chave que criptografa o token do Telegram no banco. Vazio = derivada do JWT_SECRET
# (trocar o JWT_SECRET sem definir esta chave invalida os tokens já salvos).
ENCRYPTION_KEY=
SESSION_MINUTES=720
ALLOW_REGISTRATION=false           # true = qualquer pessoa pode criar conta (não recomendado)

# Administrador inicial (criado na primeira subida se ainda não existir). Sem usuário/senha padrão.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@orbnoc.local
ADMIN_PASSWORD=

# --- Origem do frontend (só se NÃO estiver atrás do mesmo domínio da API) ---
FRONTEND_URL=http://localhost:3000
EXTRA_CORS_ORIGINS=
COOKIE_SAMESITE=lax                # "none" só com HTTPS e frontend em outro domínio

# --- Monitoramento ---
MONITOR_INTERVAL_MS=10000
MONITOR_CONCURRENCY=20
MONITOR_TIMEOUT_SECONDS=3
FAILURE_THRESHOLD=3                # falhas seguidas até marcar OFFLINE
SLA_BREACH_CONSECUTIVE=3           # amostras seguidas acima do limite até alertar
ICMP_MODE=auto                     # auto | icmp | tcp

# --- Política de alvos (proteção contra SSRF) ---
ALLOW_LOOPBACK_TARGETS=false       # true só em desenvolvimento local
ALLOW_PRIVATE_TARGETS=true         # false restringe o monitoramento a IPs públicos

# --- Retenção ---
RAW_METRICS_RETENTION_DAYS=7
HOURLY_METRICS_RETENTION_DAYS=400
EVENTS_RETENTION_DAYS=365
