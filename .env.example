# Copie para .env e ajuste. Nunca versione o .env.

# --- obrigatórios ---
POSTGRES_PASSWORD=troque-esta-senha
# mínimo de 32 caracteres; gere com: openssl rand -base64 48
JWT_SECRET=

# --- ambiente ---
ENVIRONMENT=production
PUBLIC_URL=http://localhost:8080
# origens adicionais aceitas (separadas por vírgula)
EXTRA_ORIGINS=
# true quando servido por HTTPS
COOKIE_SECURE=false
# HTTPS automático com Caddy (docker compose --profile https up -d)
SITE_ADDRESS=localhost

# --- primeiro acesso ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# o admin é criado na primeira inicialização se a senha estiver definida
ADMIN_PASSWORD=
# true redefine a senha do admin existente (recuperação); remova depois do uso
ADMIN_FORCE_RESET=false
REGISTRATION_ENABLED=false

# --- segurança e rede ---
# chave dos segredos guardados no banco (token do Telegram); se vazia, usa JWT_SECRET
ENCRYPTION_KEY=
# false bloqueia monitoramento de redes privadas (útil em instalação pública)
ALLOW_PRIVATE_NETWORKS=true

# --- ajustes do monitor (opcionais) ---
# MONITOR_CONCURRENCY=20
# PROBE_TIMEOUT_SECONDS=2
# WORKER_TICK_SECONDS=2
# METRICS_RETENTION_DAYS=14
# HOURLY_RETENTION_DAYS=400
# EVENTS_RETENTION_DAYS=90
# LOGIN_MAX_ATTEMPTS=8

# --- execução fora do Docker ---
# DATABASE_URL=postgresql://usuario:senha@host:5432/orbnoc?sslmode=require
# DATABASE_SSL=true
# PORT=8080
