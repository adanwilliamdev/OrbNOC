# Copie para .env e ajuste. Nunca versione o .env.

# --- obrigatórios ---
POSTGRES_PASSWORD=troque-esta-senha
# mínimo de 32 caracteres; gere com: openssl rand -base64 48
JWT_SECRET=

# --- ambiente ---
ENVIRONMENT=production
PUBLIC_URL=http://localhost:8080
# origens adicionais aceitas (separadas por vírgula)
EXTRA_ORIGINS=
# true quando servido por HTTPS
COOKIE_SECURE=false
# HTTPS automático com Caddy (docker compose --profile https up -d)
SITE_ADDRESS=localhost

# --- primeiro acesso ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# o admin é criado na primeira inicialização se a senha estiver definida
ADMIN_PASSWORD=
# true redefine a senha do admin existente (recuperação); remova depois do uso
ADMIN_FORCE_RESET=false
REGISTRATION_ENABLED=false
# true semeia 20 hosts de demonstração para o admin (idempotente; só para demo/testes).
# SEED_DEMO_HOSTS continua aceito como alias antigo.
ORBNOC_DEMO_SEED=false
# perfis do Spring (opcional), ex.: SPRING_PROFILES_ACTIVE=prod
# SPRING_PROFILES_ACTIVE=
# json = logs em JSON (já ativado no docker-compose.prod.yml)
# SPRING_PROFILES_ACTIVE=json

# --- segurança e rede ---
# chave dos segredos guardados no banco (token do Telegram); se vazia, usa JWT_SECRET
ENCRYPTION_KEY=
# false bloqueia monitoramento de redes privadas (útil em instalação pública)
ALLOW_PRIVATE_NETWORKS=true

# --- limites e permissões de usuários (opcionais) ---
# CIDRs privados que usuários comuns podem monitorar, separados por vírgula (ex.: 10.0.0.0/8,192.168.0.0/16).
# Vazio = sem restrição extra.
# USER_ALLOWED_CIDRS=
# máximo de dispositivos por usuário
# MAX_DEVICES_PER_USER=500
# menor intervalo de checagem permitido, em segundos
# MIN_INTERVAL_SECONDS=5   (recomendado 10 em produção; o compose de produção já usa 10)
# conexões WebSocket simultâneas por usuário
# WS_MAX_CONNECTIONS_PER_USER=10
# true = só uma instância executa o monitor por vez (trava de líder no banco)
# LEADER_LOCK_ENABLED=true

# --- rotação de chaves (opcionais) ---
# Ao trocar JWT_SECRET/ENCRYPTION_KEY, coloque o valor antigo aqui para que sessões e segredos
# já gravados continuem válidos; remova depois que expirarem/forem regravados.
# JWT_SECRET_PREVIOUS=
# ENCRYPTION_KEY_PREVIOUS=

# --- pool de conexões do banco (opcionais) ---
# DB_POOL_SIZE=12
# DB_CONNECTION_TIMEOUT_MS=5000
# detecta conexões não devolvidas ao pool após este tempo
# DB_LEAK_DETECTION_MS=30000

# --- backup automático (serviço "backup" do docker-compose.yml) ---
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP_DAYS=14

# --- ajustes do monitor (opcionais) ---
# MONITOR_CONCURRENCY=20
# PROBE_TIMEOUT_SECONDS=2
# WORKER_TICK_SECONDS=2
# METRICS_RETENTION_DAYS=14
# HOURLY_RETENTION_DAYS=400
# EVENTS_RETENTION_DAYS=90
# LOGIN_MAX_ATTEMPTS=8

# --- produção ---
# docker compose -f docker-compose.yml -f docker-compose.prod.yml --profile https up -d
# No perfil de produção ENCRYPTION_KEY (diferente do JWT_SECRET) e PUBLIC_URL (https) são obrigatórias.

# --- métricas (Actuator/Prometheus) ---
# Porta de gestão separada da aplicação; no Docker não é publicada.
# MANAGEMENT_PORT=9091
# fora do Docker o padrão é 127.0.0.1; no compose já é 0.0.0.0 (só rede interna)
# MANAGEMENT_ADDRESS=127.0.0.1
# docker compose --profile monitoring up -d  → Prometheus em http://127.0.0.1:9090

# --- execução fora do Docker ---
# DATABASE_URL=postgresql://usuario:senha@host:5432/orbnoc?sslmode=require
# DATABASE_SSL=true
# PORT=8080
