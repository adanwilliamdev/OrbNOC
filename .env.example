# Copie para .env e ajuste. `docker compose up --build` lê este arquivo.

# Obrigatórios
JWT_SECRET=            # openssl rand -hex 32
POSTGRES_PASSWORD=     # senha do PostgreSQL (não use a padrão em produção)
ADMIN_PASSWORD=        # senha do primeiro admin (letras e números, 8+ caracteres)

# Opcionais
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
REGISTRATION_ENABLED=false
ENCRYPTION_KEY=

# Endereço do Caddy. Local: :80. Produção: seu domínio (HTTPS automático).
SITE_ADDRESS=:80
# URL pública exata (com esquema). Ela é a única origem aceita em requisições que alteram estado.
PUBLIC_URL=http://localhost:8080

# Porta publicada no host (local)
HTTP_PORT=8080

# Em produção sério: ENVIRONMENT=production (exige JWT_SECRET forte e cookie Secure, ou seja, HTTPS)
ENVIRONMENT=development
ALLOW_PRIVATE_NETWORKS=true
