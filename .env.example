# Copie para .env e ajuste. Nunca versione o .env.

# --- obrigatórios ---
POSTGRES_PASSWORD=troque-esta-senha
# mínimo de 32 caracteres; gere com: openssl rand -base64 48
JWT_SECRET=

# --- ambiente ---
ENVIRONMENT=production
PUBLIC_URL=http://localhost:8080
# origens adicionais aceitas (separadas por vírgula)
EXTRA_ORIGINS=
# true quando servido por HTTPS
COOKIE_SECURE=false
# HTTPS automático com Caddy (docker compose --profile https up -d)
SITE_ADDRESS=localhost

# --- primeiro acesso ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# o admin é criado na primeira inicialização se a senha estiver definida
ADMIN_PASSWORD=
# true redefine a senha do admin existente (recuperação); remova depois do uso
ADMIN_FORCE_RESET=false
REGISTRATION_ENABLED=false
# true semeia 20 hosts de demonstração para o admin (idempotente; só para demo/testes).
# SEED_DEMO_HOSTS continua aceito como alias antigo.
ORBNOC_DEMO_SEED=false
# perfis do Spring (opcional), ex.: SPRING_PROFILES_ACTIVE=prod
# SPRING_PROFILES_ACTIVE=

# --- segurança e rede ---
# chave dos segredos guardados no banco (token do Telegram); se vazia, usa JWT_SECRET
ENCRYPTION_KEY=
# false bloqueia monitoramento de redes privadas (útil em instalação pública)
ALLOW_PRIVATE_NETWORKS=true

# --- ajustes do monitor (opcionais) ---
# MONITOR_CONCURRENCY=20
# PROBE_TIMEOUT_SECONDS=2
# WORKER_TICK_SECONDS=2
# METRICS_RETENTION_DAYS=14
# HOURLY_RETENTION_DAYS=400
# EVENTS_RETENTION_DAYS=90
# LOGIN_MAX_ATTEMPTS=8

# --- produção ---
# docker compose -f docker-compose.yml -f docker-compose.prod.yml --profile https up -d
# No perfil de produção ENCRYPTION_KEY (diferente do JWT_SECRET) e PUBLIC_URL (https) são obrigatórias.

# --- métricas (Actuator/Prometheus) ---
# Porta de gestão separada da aplicação; no Docker não é publicada.
# MANAGEMENT_PORT=9091
# fora do Docker o padrão é 127.0.0.1; no compose já é 0.0.0.0 (só rede interna)
# MANAGEMENT_ADDRESS=127.0.0.1
# docker compose --profile monitoring up -d  → Prometheus em http://127.0.0.1:9090

# --- execução fora do Docker ---
# DATABASE_URL=postgresql://usuario:senha@host:5432/orbnoc?sslmode=require
# DATABASE_SSL=true
# PORT=8080
